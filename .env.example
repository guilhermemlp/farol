# Copie este arquivo para .env e preencha.
# Necessário só na primeira sincronização: depois disso a sessão fica salva
# em .garmin_token/ e você não precisa digitar a senha de novo.
GARMIN_EMAIL=
GARMIN_PASSWORD=

# Opcional. Fuso horário (offset fixo em horas de UTC) usado para converter
# sleep_start/sleep_end (epoch UTC, vindo do Garmin) em horário local -- só
# afeta farol/sleep_regularity.py. Default -3 (America/Sao_Paulo, sem
# horário de verão desde 2019). Se você não mora nesse fuso, "Regularidade"
# em farol.today vai ficar deslocado sem nenhum aviso -- ajuste aqui.
# FAROL_TZ_OFFSET_HOURS=-3
